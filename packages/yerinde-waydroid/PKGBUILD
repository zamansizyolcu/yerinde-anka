# Maintainer: Yerinde Project

pkgname=yerinde-waydroid
pkgver=1.0.0
pkgrel=3
pkgdesc="Yerinde ANKA Waydroid Android ortam yoneticisi (GUI + TTY)"
arch=('any')
url="https://yerinde.example.com"
license=('GPL')
depends=('python' 'waydroid' 'polkit')
optdepends=('nvidia-utils: GPU ivmesi (NVIDIA donanim)')
source=('yerinde-waydroid' 'yerinde-waydroid-tty')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/yerinde-waydroid" "$pkgdir/usr/bin/yerinde-waydroid"
  install -Dm755 "$srcdir/yerinde-waydroid-tty" "$pkgdir/usr/bin/yerinde-waydroid-tty"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/yerinde-waydroid.desktop" <<'EOF'
[Desktop Entry]
Name=Waydroid (Android)
Comment=Yerinde ANKA Android ortam yoneticisi
Exec=/usr/bin/yerinde-waydroid
Icon=yerinde
Terminal=false
Type=Application
Categories=System;Emulator;
StartupNotify=true
EOF
}
