# Maintainer: Yerinde Project

pkgname=yerinde-gorev-yoneticisi
pkgver=1.0.0
pkgrel=3
pkgdesc="Yerinde ANKA gorev yoneticisi — surec, kaynak, performans"
arch=('any')
url="https://yerinde.example.com"
license=('GPL')
depends=('python' 'python-psutil' 'polkit')
source=('yerinde-gorev-yoneticisi' 'yerinde-gorev-yoneticisi-wrapper')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/yerinde-gorev-yoneticisi" "$pkgdir/usr/bin/yerinde-gorev-yoneticisi"
  install -Dm755 "$srcdir/yerinde-gorev-yoneticisi-wrapper" "$pkgdir/usr/bin/yerinde-gorev-yoneticisi-wrapper"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/yerinde-gorev-yoneticisi.desktop" <<'EOF'
[Desktop Entry]
Name=Yerinde Gorev Yoneticisi
Comment=Yerinde ANKA surec ve kaynak yoneticisi
Exec=/usr/bin/yerinde-gorev-yoneticisi-wrapper
Icon=yerinde
Terminal=false
Type=Application
Categories=System;Monitor;
StartupNotify=true
EOF
}
