[Desktop Entry]
Type=Application
Name=Yerinde ANKA Kurulumu
Name[tr]=Yerinde ANKA Kurulumu
Comment=Yerinde ANKA kurulum sihirbazını başlatır
Comment[tr]=Yerinde ANKA kurulum sihirbazını başlatır
# final33/unpackfs düzeltmesi: canlı oturum root DEĞİL (final30: User=yerinde)
# → Calamares pkexec ile yetkili çalışır; 49-yerinde-live-calamares.rules
# canlıda parola sormaz. Yerine göre sleep 3 polkit ajanının hazır olmasını
# bekler (final33 §3 emniyet).
Exec=sh -c "sleep 3; pkexec calamares"
Terminal=false
X-GNOME-Autostart-enabled=true
